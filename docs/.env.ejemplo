# ============================================================================
# Configuracion de despliegue: <nombre_proyecto>
# Las rutas APPS_* se derivan automaticamente de APPS_BASE_PATH.
# Base Tomcat aislada: <TOMCAT_HOME>\<carpeta de este proyecto>
# ============================================================================

CONTEXT_PATH=<nombre_proyecto>
PROJECT_DIR=<ruta_proyecto>
WAR_MODULE_DIR=<nombre_proyecto>-war

APPS_ENV=local
APPS_BASE_PATH=C:\apps_env

TOMCAT_HOME=C:\Program Files\Apache Software Foundation\Tomcat 9.0
TOMCAT_PORT=8080

JAVA_HOME=C:\Program Files\Java\jdk-11.0.0.2

HEALTH_CHECK_URL=http://localhost:8080/<nombre_proyecto>

JNDI_NAME=jdbc/<nombre_proyecto>DS01

DB_URL_PROPERTY=<nombre_proyecto>.db.url
DB_URL_REGVAR=XUNTA_ORACLE_URL
DB_USERNAME_PROPERTY=<nombre_proyecto>.db.username
DB_USERNAME_REGVAR=XUNTA_DB_USER_<NOMBRE>
DB_PASSWORD_PROPERTY=<nombre_proyecto>.db.password
DB_PASSWORD_REGVAR=XUNTA_DB_PASS_<NOMBRE>

DEBUG_PORT=8000

# --- Servicios Docker (opcional) ---
# Si el proyecto necesita servicios auxiliares (config server, ...), el script
# arranca el compose antes de Tomcat. Sin DOCKER_COMPOSE_FILE se detecta
# automaticamente la carpeta docker/ del proyecto.
# START_DOCKER=true
# DOCKER_COMPOSE_FILE=C:\apps_env\resources\<nombre_proyecto>\docker\docker-compose.yml
# DOCKER_WAIT_PORT=8888
# DOCKER_HEALTH_URL=http://localhost:8888/actuator/health
