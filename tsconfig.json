{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Preserve",
    "lib": ["ES2020", "DOM"],
    "outDir": "renderer",
    "rootDir": "src/renderer",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "sourceMap": false
  },
  "include": ["src/renderer/**/*.ts", "global.d.ts"]
}
